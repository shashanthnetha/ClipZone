# ClipPilot Secrets & Environment Configuration Example
# Copy this file to '.env' and fill in your real credentials.

# ── LLM Provider Secrets ──
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── YouTube Publishing Secrets (OAuth2) ──
# Enable the YouTube Data API v3 in Google Cloud Console
# Create a OAuth2 Desktop Client and retrieve credentials
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token_here

# ── Cross-Posting Publishing Secrets (Paid) ──
UPLOAD_POST_API_KEY=your_upload_post_api_key_here
UPLOAD_POST_USERNAME=your_upload_post_username_here

# ── Hosted Image Generation (Cinematic Section-B Stills) ──
GEN_IMAGE_API_KEY=your_gen_image_api_key_here

# ── CLI & Runtime Overrides (Optional) ──
# CLIPPILOT_DATA=/path/to/custom/data_dir
# CLIPPILOT_LLM_PROVIDER=anthropic
# CLIPPILOT_LLM_MODEL=claude-opus-4-8
# CLIPPILOT_BGM_VOLUME=0.12
